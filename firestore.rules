rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCommittee() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'committee';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read, create, update, delete: if isCommittee();
    }

    match /announcements/{announcementId} {
      allow read: if isCommittee()
        || (isSignedIn() && resource.data.isPublished == true);
      allow create, update, delete: if isCommittee();
    }

    match /attendance_records/{recordId} {
      allow read, write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
